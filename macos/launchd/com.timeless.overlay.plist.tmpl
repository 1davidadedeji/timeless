<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.timeless.overlay</string>
  <key>ProgramArguments</key>
  <array>
    <string>SUPPORT/bin/TimelessOverlay</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TIMELESS_URL</key>
    <string>http://127.0.0.1:8787</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>HOME/Library/Application Support/Timeless/logs/overlay.log</string>
  <key>StandardErrorPath</key>
  <string>HOME/Library/Application Support/Timeless/logs/overlay.err</string>
</dict>
</plist>
