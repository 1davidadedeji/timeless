<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.timeless.sp-ingest</string>
  <key>ProgramArguments</key>
  <array>
    <string>VENV/bin/python</string>
    <string>ROOT/scripts/sp_ingest.py</string>
  </array>
  <key>StartInterval</key>
  <integer>180</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>HOME/Library/Application Support/Timeless/logs/sp-ingest.log</string>
  <key>StandardErrorPath</key>
  <string>HOME/Library/Application Support/Timeless/logs/sp-ingest.err</string>
</dict>
</plist>
