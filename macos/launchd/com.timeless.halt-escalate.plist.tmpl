<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.timeless.halt-escalate</string>
  <key>ProgramArguments</key>
  <array>
    <string>VENV/bin/python</string>
    <string>ROOT/scripts/halt_escalate.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>TIMELESS_URL</key>
    <string>http://127.0.0.1:8787</string>
  </dict>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>HOME/Library/Application Support/Timeless/logs/halt-escalate.log</string>
  <key>StandardErrorPath</key>
  <string>HOME/Library/Application Support/Timeless/logs/halt-escalate.err</string>
</dict>
</plist>
